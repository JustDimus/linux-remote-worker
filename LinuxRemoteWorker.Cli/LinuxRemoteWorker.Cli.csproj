<Project Sdk="Microsoft.NET.Sdk">

  <!--
    lrw - the command line (and MCP server) for Linux Remote Worker. Every command is a method in
    Commands/ marked with [Command]; the same catalog drives the CLI, its help, `lrw schema` and the
    MCP tools, so the three can never drift apart.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LinuxRemoteWorker.Cli</RootNamespace>
    <AssemblyName>lrw</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinuxRemoteWorker.Core\LinuxRemoteWorker.Core.csproj" />
  </ItemGroup>

</Project>
