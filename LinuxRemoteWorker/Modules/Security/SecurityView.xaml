<UserControl x:Class="LinuxRemoteWorker.Modules.Security.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LinuxRemoteWorker.Converters"
             xmlns:b="clr-namespace:LinuxRemoteWorker.Behaviors">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility"/>
        <conv:ErrorColorConverter x:Key="ErrorColorConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3D5AFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0 2 16 2"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0 2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Busy overlay -->
        <Grid Panel.ZIndex="100" Visibility="{Binding IsBusySecurity, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#AA13131F"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Canvas Width="48" Height="48" HorizontalAlignment="Center">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="SpinTransform" Angle="0" CenterX="24" CenterY="24"/>
                    </Canvas.RenderTransform>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="Canvas.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinTransform"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                    <Ellipse Width="48" Height="48" StrokeThickness="4" Stroke="#2A2A4E"/>
                    <Path Stroke="#3D5AFE" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 24,4 A 20,20 0 0 1 44,24"/>
                </Canvas>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#AAA" FontSize="13"
                           HorizontalAlignment="Center" Margin="0 16 0 0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- Header -->
                <DockPanel Margin="0 0 0 24">
                    <TextBlock Text="Security" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <Button Content="↻ Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryBtn}" DockPanel.Dock="Right" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- This connection -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="THIS CONNECTION" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding SessionText}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PrivilegesText}" FontSize="12" Margin="0 4 0 0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#AAA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoPrivileges}" Value="True">
                                            <Setter Property="Foreground" Value="#E0A060"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding HostKeyText}" Foreground="#6CCF97" FontFamily="Consolas" FontSize="11"
                                   Margin="0 6 0 0" TextWrapping="Wrap"/>
                        <TextBlock Foreground="#555" FontSize="11" Margin="0 4 0 0" TextWrapping="Wrap"
                                   Text="The server key is remembered on the first login; if it ever changes, the app refuses to connect until you confirm it."/>
                    </StackPanel>
                </Border>

                <!-- Login settings -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="SSH LOGIN SETTINGS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding PasswordLoginText}" FontSize="14" Margin="0 0 0 10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6CCF97"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PasswordLoginAllowed}" Value="True">
                                            <Setter Property="Foreground" Value="#E0A060"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PasswordAuthentication" Style="{StaticResource Key}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PasswordAuthText}" Style="{StaticResource Val}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="KbdInteractiveAuthentication" Style="{StaticResource Key}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InteractiveText}" Style="{StaticResource Val}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PubkeyAuthentication" Style="{StaticResource Key}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PubkeyText}" Style="{StaticResource Val}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="PermitRootLogin" Style="{StaticResource Key}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RootLoginText}" Style="{StaticResource Val}"/>
                        </Grid>

                        <StackPanel Visibility="{Binding PasswordLoginAllowed, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Disable password login" Command="{Binding DisablePasswordLoginCommand}"
                                    IsEnabled="{Binding CanDisablePasswordLogin}"
                                    Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding DisableBlockedReason}" Foreground="#888" FontSize="12" Margin="0 8 0 0" TextWrapping="Wrap"
                                       Visibility="{Binding DisableBlockedReason, Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding PolicyInstalled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#666" FontSize="12" Margin="0 0 0 8" TextWrapping="Wrap"
                                       Text="Turned off by Linux Remote Worker (/etc/ssh/sshd_config.d/00-lrw-password-login.conf)."/>
                            <Button Content="Allow password login again" Command="{Binding EnablePasswordLoginCommand}"
                                    Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- This computer's key -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="SSH KEY FOR THIS COMPUTER" Style="{StaticResource SectionLabel}"/>

                        <TextBlock Text="Use a key you already have - only its public half goes to the server" Foreground="#AAA" FontSize="12" Margin="0 0 0 6"/>
                        <Grid Margin="0 0 0 14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                <TextBlock Text="Private key file" Foreground="#555" FontSize="10" Margin="0 0 0 3"/>
                                <TextBox Text="{Binding MyKeyPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseMyKeyCommand}"
                                    Style="{StaticResource SecondaryBtn}" VerticalAlignment="Bottom" Margin="0 0 8 0"/>
                            <StackPanel Grid.Column="2" Margin="0 0 8 0">
                                <TextBlock Text="Passphrase (if any)" Foreground="#555" FontSize="10" Margin="0 0 0 3"/>
                                <PasswordBox x:Name="MyKeyPassBox" Height="34" Padding="8 6" VerticalContentAlignment="Center"
                                             Background="#1E1E2E" Foreground="White" BorderBrush="#2A2A3E" BorderThickness="1" CaretBrush="White"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Add &amp; test" Command="{Binding AddMyKeyCommand}"
                                    Style="{StaticResource PrimaryBtn}" VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Or create a new key pair" Foreground="#AAA" FontSize="12" Margin="0 0 0 2"/>
                        <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap" Margin="0 0 0 6"
                                   Text="Made on the server, downloaded (readable only by you), added to authorized_keys, removed from the server and tested. Also a way to hand a key to another device - but pasting that device's own public key below is safer."/>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                <TextBlock Text="Save the private key as" Foreground="#555" FontSize="10" Margin="0 0 0 3"/>
                                <TextBox Text="{Binding KeyPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseKeyPathCommand}"
                                    Style="{StaticResource SecondaryBtn}" VerticalAlignment="Bottom" Margin="0 0 8 0"/>
                            <Button Grid.Column="2" Content="Create, download &amp; test" Command="{Binding CreateKeyCommand}"
                                    Style="{StaticResource PrimaryBtn}" VerticalAlignment="Bottom"/>
                        </Grid>

                        <Border Background="#13131F" CornerRadius="6" Padding="12 10" Margin="0 4 0 0"
                                Visibility="{Binding CreatedKey, Converter={StaticResource NotNullToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="✓ Logging in with this key works" Foreground="#6CCF97" FontSize="13"/>
                                <TextBlock Text="{Binding CreatedKey.LocalPath}" Foreground="#DDD" FontFamily="Consolas" FontSize="11" Margin="0 4 0 0"/>
                                <TextBlock Text="{Binding CreatedKey.Fingerprint}" Foreground="#888" FontFamily="Consolas" FontSize="11"/>
                                <StackPanel Visibility="{Binding CanUseCreatedKey, Converter={StaticResource BoolToVisibility}}" Margin="0 10 0 0">
                                    <Button Content="Use this key for this connection" Command="{Binding UseCreatedKeyCommand}"
                                            Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                                    <TextBlock Foreground="#666" FontSize="11" Margin="0 6 0 0" TextWrapping="Wrap"
                                               Text="Reconnects with the key and saves it in the selected profile. After that, password login can be turned off."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Another device's key -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="LET ANOTHER DEVICE IN" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0 0 0 10">
                            <Run Text="On the other device (Mac, Linux, another PC) create a key if it has none -"/>
                            <Run Text="ssh-keygen -t ed25519" FontFamily="Consolas" Foreground="#AAA"/>
                            <Run Text="- then copy its public key:"/>
                            <Run Text="cat ~/.ssh/id_ed25519.pub" FontFamily="Consolas" Foreground="#AAA"/>
                            <Run Text="and paste it here. Its private key never leaves that device."/>
                        </TextBlock>
                        <TextBox Text="{Binding PublicKeyText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#13131F" Foreground="#DDD" BorderBrush="#2A2A3E" BorderThickness="1" CaretBrush="White"
                                 FontFamily="Consolas" FontSize="11" Padding="8 6" Height="56"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="{Binding PublicKeyPreview}" FontFamily="Consolas" FontSize="11" Margin="0 4 0 8" TextWrapping="Wrap"
                                   Visibility="{Binding PublicKeyPreview, Converter={StaticResource StringToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6CCF97"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PublicKeyInvalid}" Value="True">
                                            <Setter Property="Foreground" Value="#CF6279"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Load .pub file" Command="{Binding BrowsePublicKeyCommand}"
                                    Style="{StaticResource SecondaryBtn}" VerticalAlignment="Bottom" Margin="0 0 8 0"/>
                            <StackPanel Grid.Column="1" Margin="0 0 8 0">
                                <TextBlock Text="Log in as (empty: this user)" Foreground="#555" FontSize="10" Margin="0 0 0 3"/>
                                <TextBox Text="{Binding PublicKeyUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Add key" Command="{Binding AddPublicKeyCommand}"
                                    Style="{StaticResource PrimaryBtn}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Foreground="#555" FontSize="11" Margin="0 8 0 0" TextWrapping="Wrap">
                            <Run Text="Compare the fingerprint above with the one the other device shows:"/>
                            <Run Text="ssh-keygen -lf ~/.ssh/id_ed25519.pub" FontFamily="Consolas" Foreground="#888"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Admin user -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="ADMIN USER INSTEAD OF ROOT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0 0 0 12"
                                   Text="Creates a Linux user with passwordless sudo and its own SSH key, then logs in as it and runs sudo to prove both work. The app keeps working as that user - it runs its commands through sudo."/>
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0 0 12 0">
                                <TextBlock Text="New user name (for example admin)" Foreground="#555" FontSize="10" Margin="0 0 0 3"/>
                                <TextBox Text="{Binding AdminUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="Also let in the keys that log in as this user now" IsChecked="{Binding CopyKeys}"
                                      Foreground="#AAA" FontSize="12" VerticalAlignment="Bottom" Margin="0 0 0 9"/>
                            <Button Grid.Column="2" Content="Create admin user" Command="{Binding CreateAdminCommand}"
                                    Style="{StaticResource PrimaryBtn}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Foreground="#444" FontSize="11" TextWrapping="Wrap"
                                   Text="Its private key is saved in your .ssh folder as lrw_&lt;server&gt;_&lt;user&gt;_ed25519."/>

                        <Border Background="#13131F" CornerRadius="6" Padding="12 10" Margin="0 10 0 0"
                                Visibility="{Binding CreatedAdmin, Converter={StaticResource NotNullToVisibility}}">
                            <StackPanel>
                                <TextBlock Foreground="#6CCF97" FontSize="13"
                                           Text="{Binding CreatedAdmin.User, StringFormat='✓ {0} logs in with its key and has passwordless sudo'}"/>
                                <TextBlock Text="{Binding CreatedAdmin.Key.LocalPath}" Foreground="#DDD" FontFamily="Consolas" FontSize="11" Margin="0 4 0 0"/>
                                <StackPanel Visibility="{Binding CanSwitchToAdmin, Converter={StaticResource BoolToVisibility}}" Margin="0 10 0 0">
                                    <Button Content="{Binding CreatedAdmin.User}" ContentStringFormat="Switch this connection to {0}"
                                            Command="{Binding SwitchToAdminCommand}" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                                    <TextBlock Foreground="#666" FontSize="11" Margin="0 6 0 0" TextWrapping="Wrap"
                                               Text="Reconnects as the new user with its key and saves that in the selected profile. Then root login can be turned off."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Root login -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="ROOT LOGIN" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding RootLoginStateText}" FontSize="14" Margin="0 0 0 10" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#6CCF97"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RootLoginAllowed}" Value="True">
                                            <Setter Property="Foreground" Value="#E0A060"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Visibility="{Binding RootLoginAllowed, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Disable root login" Command="{Binding DisableRootLoginCommand}"
                                    IsEnabled="{Binding CanDisableRootLogin}"
                                    Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding DisableRootBlockedReason}" Foreground="#888" FontSize="12" Margin="0 8 0 0" TextWrapping="Wrap"
                                       Visibility="{Binding DisableRootBlockedReason, Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding RootPolicyInstalled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#666" FontSize="12" Margin="0 0 0 8" TextWrapping="Wrap"
                                       Text="Turned off by Linux Remote Worker (/etc/ssh/sshd_config.d/00-lrw-root-login.conf)."/>
                            <Button Content="Allow root login again" Command="{Binding EnableRootLoginCommand}"
                                    Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Authorized keys -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                    <StackPanel>
                        <TextBlock Text="KEYS THAT CAN LOG IN AS THIS USER" Style="{StaticResource SectionLabel}"/>
                        <ItemsControl ItemsSource="{Binding AuthorizedKeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#13131F" CornerRadius="6" Padding="12 8" Margin="0 3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Type}" Foreground="#7B8CDE" FontSize="12" Margin="0 0 8 0"/>
                                                    <TextBlock Text="{Binding Comment}" Foreground="White" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Fingerprint}" Foreground="#888" FontFamily="Consolas" FontSize="11" Margin="0 2 0 0"/>
                                                <TextBlock Text="{Binding File}" Foreground="#555" FontSize="10" Margin="0 2 0 0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" ToolTip="Stop this key from logging in (a lost device)"
                                                    Command="{Binding DataContext.RemoveKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#666" BorderThickness="0"
                                                    Padding="8 4" FontSize="14" Cursor="Hand" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No authorized keys - this user can only log in with a password." Foreground="#666" FontSize="12"
                                   Visibility="{Binding AuthorizedKeys.Count, Converter={StaticResource ZeroCountToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- Output log -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0 0 0 16"
                        Visibility="{Binding OutputLog, Converter={StaticResource StringToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabel}"/>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" b:AutoScroll.ToEnd="True">
                            <TextBlock Text="{Binding OutputLog}" Foreground="#6CCF97" FontFamily="Consolas"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"
                           Foreground="{Binding HasError, Converter={StaticResource ErrorColorConverter}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
