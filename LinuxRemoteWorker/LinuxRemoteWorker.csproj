<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Program.Main runs Velopack's hooks before WPF starts -->
    <StartupObject>LinuxRemoteWorker.Program</StartupObject>
    <!-- The exe's icon: taskbar, Explorer, shortcuts (the installer gets it from the release workflow's vpk pack) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public half of the update signing key (tools/new-update-signing-key.ps1); without it updates stay off -->
    <EmbeddedResource Include="Update\update-signing.pub.pem" LogicalName="update-signing.pub.pem"
                      Condition="Exists('Update\update-signing.pub.pem')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinuxRemoteWorker.Core\LinuxRemoteWorker.Core.csproj" />
  </ItemGroup>

</Project>
