<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that talks to a server: SSH transport, the server-side layout, and one service per
    module. No UI dependencies, so the desktop app and the lrw command line share the same code.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LinuxRemoteWorker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinuxRemoteWorker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
